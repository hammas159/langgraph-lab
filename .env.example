# Everything runs locally. There is no API key in this repo and no project needs one.

# Where ollama is listening.
OLLAMA_HOST=http://127.0.0.1:11434

# Override the default chat model for every project at once. Leave unset to use the
# registry default in shared/models.py.
# LANGCHAIN_LAB_MODEL=qwen2.5:3b-instruct
